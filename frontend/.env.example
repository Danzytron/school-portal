# ==============================================================================
# Cebu Eastern College (CEC) School Portal - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloudflare Turnstile Configuration
# Obtain these from: Cloudflare Dashboard -> Turnstile -> Add Site
# ------------------------------------------------------------------------------

# Frontend Public Site Key (exposed to browser for rendering Turnstile widget)
# For testing/demo, Cloudflare provides a dummy key: 1x00000000000000000000AA (Always passes)
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Backend Server Secret Key (NEVER expose to frontend/client or commit to Git)
# For testing/demo, Cloudflare provides a dummy secret: 1x0000000000000000000000000000000AA (Always passes)
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ------------------------------------------------------------------------------
# 2. Site Metadata & Search Console Verification
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://cebucecportal.site
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ------------------------------------------------------------------------------
# 3. Google Gemini API Configuration (CEC AI Assistant)
# Server-side ONLY. Do NOT use NEXT_PUBLIC_ prefix to prevent key leakage.
# Obtain from: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash
